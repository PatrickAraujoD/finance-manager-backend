    "eslint-plugin-boundaries": "^7.4.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
