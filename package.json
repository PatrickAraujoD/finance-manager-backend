{
  "name": "finance-manager-backend",
  "version": "0.1.0",
  "description": "API REST de gestão financeira pessoal",
  "main": "dist/main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "lint": "eslint .",
    "test": "jest --config jest.config.js test/unit",
    "test:integration": "jest --config jest.config.js test/integration --passWithNoTests",
    "test:e2e": "jest --config jest.config.js test/e2e",
    "prepare": "husky"
  },
  "repository": {
