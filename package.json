{
  "name": "finance-manager-backend",
  "version": "2.0.0",
  "description": "API REST de gestão financeira pessoal",
  "main": "dist/main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env -r ts-node/register src/main.ts",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "test": "jest --config jest.config.js test/unit",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "jest --config jest.e2e.config.js",
    "seed": "node --env-file-if-exists=.env -r ts-node/register prisma/seed.ts",
    "fixtures": "ts-node test/fixtures/generate.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickAraujoD/finance-manager-backend.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/PatrickAraujoD/finance-manager-backend/issues"
  },
  "homepage": "https://github.com/PatrickAraujoD/finance-manager-backend#readme",
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@tesseract.js-data/por": "^1.0.0",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0",
    "validator": "^13.15.35",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "private": true,
  "overrides": {
    "multer": "^2.5.0"
  }
}
