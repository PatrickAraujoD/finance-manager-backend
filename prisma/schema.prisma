generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  A
  N
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  passwordHash  String
  role          Role
  active        Boolean        @default(true)
  failedLogins  Int            @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  categories    Category[]
  expenses      Expense[]
  incomes       MonthlyIncome[]
}

model RefreshToken {
  id        String    @id
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

model Category {
  id        String    @id
  name      String
  // Normalized name (Unicode NFC, lowercase) computed by the domain: case-insensitive uniqueness.
  nameKey   String
  // NULL = global category. UNIQUE(ownerId, nameKey) does not cover NULL owners in Postgres, so
  // globals get a partial unique index added by SQL in the migration.
  ownerId   String?
  createdAt DateTime  @default(now())
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  expenses  Expense[]

  @@unique([ownerId, nameKey])
}

// Only the schema for now (the repository comes with the expenses task); it makes the category
// "in use" check and the delete restriction real.
model Expense {
  id          String   @id
  userId      String
  categoryId  String
  // Plain column until the Receipt table exists.
  receiptId   String?
  // Integer cents; BigInt so any safe integer fits.
  amountCents BigInt
  paidAlone   Boolean
  // Calendar date (no time zone).
  spentAt     DateTime @db.Date
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, spentAt])
  @@index([categoryId])
}

// One income per user and month. Cascade: the row has no meaning without its user (unlike
// expenses, which are protected with Restrict), so erasing a user erases the income.
// CHECKs (month format, amount > 0) live in the migration SQL.
model MonthlyIncome {
  userId      String
  // YYYY-MM
  month       String
  // Integer cents; BigInt so any safe integer fits.
  amountCents BigInt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
}
