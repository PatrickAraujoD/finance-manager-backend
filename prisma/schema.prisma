generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  A
  N
}

enum PaymentMethod {
  CREDIT
  DEBIT
  PIX
  CASH
}

enum LoanPaymentMethod {
  CASH
  PIX
}

model User {
  id            String          @id
  name          String
  email         String          @unique
  passwordHash  String
  role          Role
  active        Boolean         @default(true)
  failedLogins  Int             @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  categories    Category[]
  expenses      Expense[]
  incomes       MonthlyIncome[]
  receipts      Receipt[]
  loans         Loan[]
  loanPayments  LoanPayment[]
}

model RefreshToken {
  id        String    @id
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

model Category {
  id        String    @id
  name      String
  // Normalized name (Unicode NFC, lowercase) computed by the domain: case-insensitive uniqueness.
  nameKey   String
  // NULL = global category. UNIQUE(ownerId, nameKey) does not cover NULL owners in Postgres, so
  // globals get a partial unique index added by SQL in the migration.
  ownerId   String?
  createdAt DateTime  @default(now())
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  expenses  Expense[]

  @@unique([ownerId, nameKey])
}

// receiptId is UNIQUE: one receipt backs at most one expense. Postgres treats NULLs as distinct,
// so any number of manual expenses (receiptId NULL) is fine. CHECK amountCents > 0 lives in the
// migration SQL.
model Expense {
  id            String        @id
  userId        String
  categoryId    String
  receiptId     String?       @unique
  // Integer cents; BigInt so any safe integer fits.
  amountCents   BigInt
  paidAlone     Boolean
  paymentMethod PaymentMethod
  // Pays the credit card bill; those expenses are left out of the spending reports.
  isCardPayment Boolean       @default(false)
  // Calendar date (no time zone).
  spentAt       DateTime      @db.Date
  description   String?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receipt       Receipt?      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  loan          Loan?

  @@index([userId, spentAt])
  @@index([categoryId])
}

// One income per user and month. Cascade: the row has no meaning without its user (unlike
// expenses, which are protected with Restrict), so erasing a user erases the income.
// CHECKs (month format, amount > 0) live in the migration SQL.
model MonthlyIncome {
  userId      String
  // YYYY-MM
  month       String
  // Integer cents; BigInt so any safe integer fits.
  amountCents BigInt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
}

// Uploaded proof of payment. The file itself lives in the FileStorage under storageKey.
// Restrict on both sides: a user with receipts, or a receipt used by an expense, cannot be
// deleted silently. CHECK suggestedAmountCents > 0 lives in the migration SQL.
model Receipt {
  id                   String   @id
  userId               String
  storageKey           String   @unique
  mimeType             String
  sizeBytes            Int
  // Integer cents; BigInt so any safe integer fits. NULL = nothing reliable was extracted.
  suggestedAmountCents BigInt?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  expense              Expense?
  loanPayment          LoanPayment?

  @@index([userId])
}

// Money lent to someone. expenseId is UNIQUE: an expense turns into at most one loan (the amount is
// copied from it); NULL for money lent directly, and Postgres treats NULLs as distinct. Restrict
// on both sides: a user or an expense that has a loan cannot be deleted silently. CHECKs
// (amountCents > 0 and the amount ceiling) live in the migration SQL.
model Loan {
  id           String   @id
  userId       String
  borrowerName String
  // Integer cents; BigInt so any safe integer fits.
  amountCents  BigInt
  // Calendar date (no time zone).
  dueDate      DateTime @db.Date
  expenseId    String?  @unique
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  expense      Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  payments     LoanPayment[]

  @@index([userId, dueDate])
  @@index([userId, borrowerName])
}

// A payment toward one specific loan. receiptId is UNIQUE: one receipt backs at most one payment
// (the code also refuses a receipt that backs an expense); NULL for cash, and Postgres treats
// NULLs as distinct. Restrict everywhere: a loan, a user or a receipt that has payments cannot be
// deleted silently. CHECKs (amountCents > 0, the amount ceiling, and PIX <=> receipt) live in the
// migration SQL. The sum of a loan's payments never passing its amount is enforced in code under
// a row lock on the loan (see PrismaLoanPaymentRepository.add).
model LoanPayment {
  id          String            @id
  loanId      String
  userId      String
  // Integer cents; BigInt so any safe integer fits.
  amountCents BigInt
  method      LoanPaymentMethod
  receiptId   String?           @unique
  // Calendar date (no time zone).
  paidAt      DateTime          @db.Date
  createdAt   DateTime          @default(now())
  loan        Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  receipt     Receipt?          @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([loanId, paidAt])
  @@index([userId])
}
