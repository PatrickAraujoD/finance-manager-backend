# Postgres do docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
# Gere o segredo com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-segredo-gerado-com-openssl-rand-base64-48
# Diretorio privado dos comprovantes (criado com permissao 0700); fora do diretorio publico
UPLOAD_DIR=./uploads
PORT=3000

# CORS: lista de origens permitidas separadas por virgula; vazio = CORS desligado
CORS_ORIGINS=
# 'false' (padrao) ou o numero EXATO de saltos de proxy confiaveis (inteiro >= 1, ex. 1).
# 'true' e '0' sao recusados. Atras de proxy reverso use o numero exato de saltos.
TRUST_PROXY=false
# Rate limit por IP: janela em segundos, limite geral e limite de /auth/login, /auth/register, /auth/refresh
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=20
# Limite adicional do /auth/login por IP + e-mail normalizado
LOGIN_EMAIL_THROTTLE_LIMIT=5
# Uploads de comprovante por usuario autenticado (IP se anonimo) na janela acima
UPLOAD_THROTTLE_LIMIT=10

# Seed do primeiro admin (npm run seed). Use uma senha propria com 12 a 128 caracteres;
# nao reutilize valores de exemplo e nao versione o .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
